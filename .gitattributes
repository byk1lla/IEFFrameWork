# Composer create-project / git archive — paket dağıtımında dışlanan yollar
# (Geliştirme reposu klonlanırken bunlar görünür; paket olarak indirildiğinde gelmez.)

/docs                    export-ignore
/.github                 export-ignore
/.gitattributes          export-ignore
/.gitignore              export-ignore
/composer.lock           export-ignore
/sessions                export-ignore
/storage/logs            export-ignore
/storage/cache           export-ignore
/storage/sessions        export-ignore
/storage/installed.lock  export-ignore
/test                    export-ignore
/tests                   export-ignore
/.editorconfig           export-ignore
/.vscode                 export-ignore

# Satır sonları
* text=auto eol=lf
*.sh text eol=lf
*.bat text eol=crlf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
